 free public PubChem files and keeps the best-known structures, with how often each one is recorded in\n# PubChem and linked to PubMed. Notebook 4 uses the table as extra candidates and as a popularity signal.\n#\n# Kaggle settings: Accelerator = None (uses no GPU hours), Internet = On.\n# Create the notebook from the competition's Code tab, so the competition data is attached.\n# Add Input: Datasets: \"coconut-casmi26-candidates\" by prvsiyan.\n# Click Save Version > Save & Run All. It should take 1 to 2 hours, mostly downloading.\n# Then add this notebook as an input to Notebook 4: + Add Input > Your Work > Notebooks.\n\nimport csv\nimport glob\nimport os\nimport pickle\nimport re\nimport shutil\nimport subprocess\nimport time\n\nimport numpy as np\nimport pandas as pd\nimport pyarrow as pa\nimport pyarrow.parquet as pq\n\nBASE_URL = \"https://ftp.ncbi.nlm.nih.gov/pubchem/Compound/Extras/\"\nDOWNLOADS = \"/tmp/pubchem\"\nOUTPUT = \"/kaggle/working/pubchem_known.parquet\"\nMAX_STRUCTURES = 15_000_000  # Keeps pool structures and any with PubMed links, then the most recorded others up to this.\nMIN_MASS = 150.0\nMAX_MASS = 1200.0\nORGANIC = r\"(?:(?:Cl|Br|C|H|N|O|P|S|F|I)\\d*)+\"\nCHUNK = 5_000_000\nEXPECTED_FIELDS = {\"CID-Mass.gz\": 4, \"CID-PMID.gz\": 3, \"CID-SID.gz\": 3, \"CID-InChI-Key.gz\": 3, \"CID-SMILES.gz\": 2}\nSTARTED = time.time()\n\n\ndef log(message):\n    print(f\"[{(time.time() - STARTED) / 60:6.1f} min] {message}\", flush=True)\n\n\ndef find_one(name, hint):\n    found = glob.glob(f\"/kaggle/input/**/{name}\", recursive=True)\n    if not found:\n        raise FileNotFoundError(f\"{name} not found. Use + Add Input to attach {hint}.\")\n    return found[0]\n\n\ndef check_formats():\n    \"\"\"Look at the start of each file, so a changed format fails now rather than an hour in.\"\"\"\n    if shutil.which(\"curl\") is None:\n        raise RuntimeError(\"curl is missing from this Kaggle image. Paste this error back.\")\n    for name, fields in EXPECTED_FIELDS.items():\n        command = f\"curl -fsSL -r 0-200000 {BASE_URL}{name} | gzip -dc 2>/dev/null | head -n 1\"\n        line = subprocess.run(command, shell=True, capture_output=True, text=True).stdout.rstrip(\"\\n\")\n        columns = line.split(\"\\t\")\n        print(f\"  {name}: {line[:100]}\", flush=True)\n        if len(columns) != fields or not columns[0].isdigit():\n            raise RuntimeError(f\"{name} did not look as expected. Is Internet on? First line: {line[:300]!r}\")\n\n\ndef fetch(name):\n    \"\"\"Download one file, resuming after failures, and confirm its checksum.\"\"\"\n    path = os.path.join(DOWNLOADS, name)\n    url = BASE_URL + name\n    checksum = subprocess.run([\"curl\", \"-fsSL\", \"--retry\", \"5\", url + \".md5\"], capture_output=True, text=True, check=True)\n    expected = re.search(r\"[0-9a-f]{32}\", checksum.stdout).group()\n    for attempt in range(6):\n        finished = subprocess.run(\n            [\"curl\", \"-fsSL\", \"--retry\", \"5\", \"--retry-delay\", \"30\", \"-C\", \"-\", \"-o\", path, url]\n        ).returncode == 0\n        if finished:\n            actual = subprocess.run([\"md5sum\", path], capture_output=True, text=True, check=True).stdout.split()[0]\n            if actual == expected:\n                log(f\"downloaded {name}, {os.path.getsize(path) / 1e9:.1f} GB\")\n                return path\n            os.remove(path)\n        log(f\"download of {name} did not finish on attempt {attempt + 1}, retrying\")\n        time.sleep(30)\n    raise RuntimeError(f\"Could not download {name}.\")\n\n\ndef read_fields(path, fields, names):\n    \"\"\"Yield chunks of the chosen tab-separated fields from a gzipped file.\"\"\"\n    process = subprocess.Popen(f\"gzip -dc {path} | cut -f{fields}\", shell=True, stdout=subprocess.PIPE)\n    types = {name: np.int64 if name == \"cid\" else str for name in names}\n    yield from pd.read_csv(\n        process.stdout,\n        sep=\"\\t\",\n        header=None,\n        names=names,\n        dtype=types,\n        na_filter=False,\n        quoting=csv.QUOTE_NONE,\n        chunksize=CHUNK,\n    )\n    if process.wait() != 0:\n        raise RuntimeError(f\"Reading {path} failed.\")\n\n\ndef read_masses():\n    \"\"\"Monoisotopic mass by CID, zero for structures outside the mass range or with other elements or a net charge.\"\"\"\n    path = fetch(\"CID-Mass.gz\")\n    cid_parts, mass_parts = [], []\n    total = 0\n    for chunk in read_fields(path, \"1,2,3\", [\"cid\", \"formula\", \"mass\"]):\n        total += len(chunk)\n        mass = pd.to_numeric(chunk[\"mass\"], errors=\"coerce\").to_numpy(dtype=float)\n        keep = (mass >= MIN_MASS) & (mass <= MAX_MASS)\n        keep &= chunk[\"formula\"].str.fullmatch(ORGANIC, na=False).to_numpy(dtype=bool)\n        cid_parts.append(chunk[\"cid\"].to_numpy()[keep])\n        mass_parts.append(mass[keep])\n    os.remove(path)\n    cids = np.concatenate(cid_parts)\n    masses = np.zeros(int(cids.max()) + 1)\n    masses[cids] = np.concatenate(mass_parts)\n    log(f\"CID-Mass: kept {cids.size:,} of {total:,} structures\")\n    return masses\n\n\ndef count_links(name, size):\n    \"\"\"How many lines of a PubChem link file mention each CID.\"\"\"\n    path = fetch(name)\n    counts = np.zeros(size, dtype=np.uint32)\n    total = 0\n    for chunk in read_fields(path, \"1\", [\"cid\"]):\n        total += len(chunk)\n        values = chunk[\"cid\"].to_numpy()\n        np.add.at(counts, values[values < size], 1)\n    os.remove(path)\n    log(f\"{name}: {total:,} links, {np.count_nonzero(counts):,} of our structures have at least one\")\n    return counts\n\n\ndef read_keys(masses):\n    \"\"\"First InChIKey block by CID, for the structures still in play.\"\"\"\n    path = fetch(\"CID-InChI-Key.gz\")\n    keys = np.zeros(masses.size, dtype=\"S14\")\n    for chunk in read_fields(path, \"1,3\", [\"cid\", \"key\"]):\n        values = chunk[\"cid\"].to_numpy()\n        wanted = values < masses.size\n        wanted[wanted] = masses[values[wanted]] > 0\n        wanted &= chunk[\"key\"].str.len().to_numpy() == 27\n        keys[values[wanted]] = chunk[\"key\"][wanted].str[:14].to_numpy().astype(\"S14\")\n    os.remove(path)\n    log(\"CID-InChI-Key: read\")\n    return keys\n\n\ndef locate(sorted_values, queries):\n    \"\"\"Positions of queries in a sorted array, and which of them were found.\"\"\"\n    positions = np.searchsorted(sorted_values, queries)\n    positions[positions == sorted_values.size] = 0\n    return positions, sorted_values[positions] == queries\n\n\ndef read_smiles(representatives, size):\n    \"\"\"SMILES for each representative CID, leaving out salts and mixtures.\"\"\"\n    row_of = np.full(size, -1, dtype=np.int32)\n    row_of[representatives] = np.arange(representatives.size, dtype=np.int32)\n    texts = np.empty(representatives.size, dtype=object)\n    path = fetch(\"CID-SMILES.gz\")\n    for chunk in read_fields(path, \"1,2\", [\"cid\", \"smiles\"]):\n        values = chunk[\"cid\"].to_numpy()\n        wanted = values < size\n        wanted[wanted] = row_of[values[wanted]] >= 0\n        rows = chunk[wanted]\n        rows = rows[~rows[\"smiles\"].str.contains(\".\", regex=False, na=True)]\n        texts[row_of[rows[\"cid\"].to_numpy()]] = rows[\"smiles\"].to_numpy()\n    os.remove(path)\n    log(\"CID-SMILES: read\")\n    return texts\n\n\nTRAIN = find_one(\"train.parquet\", \"the competition data\")\nCOCO = find_one(\"coco_meta.pkl\", 'the dataset \"coconut-casmi26-candidates\" by prvsiyan')\nos.makedirs(DOWNLOADS, exist_ok=True)\nlog(\"checking file formats\")\ncheck_formats()\n\ntrain = pq.read_table(TRAIN, columns=[\"ingest_lib\", \"inchikey14\"]).to_pandas()\nlibrary_keys = train[\"inchikey14\"].dropna().unique().astype(\"S14\")\npanel_keys = train.loc[train[\"ingest_lib\"] == \"enveda-np-examples\", \"inchikey14\"].dropna().unique().astype(\"S14\")\ndel train\nwith open(COCO, \"rb\") as handle:\n    coconut_keys = np.array([key for key in pickle.load(handle)[\"keys\"] if isinstance(key, str)], dtype=\"S14\")\npool_keys = np.unique(np.concatenate([library_keys, coconut_keys]))\nlog(f\"pool: {library_keys.size:,} library keys, {coconut_keys.size:,} COCONUT keys, {panel_keys.size} panel keys\")\n\nmasses = read_masses()\nsize = masses.size\npmid_counts = count_links(\"CID-PMID.gz\", size)\nsid_counts = count_links(\"CID-SID.gz\", size)\nkeys = read_keys(masses)\n\n# Group structures that differ only in stereochemistry, since the competition's key ignores it.\nkept = np.flatnonzero(keys != b\"\")\norder = kept[np.argsort(keys[kept], kind=\"stable\")]\nsorted_keys = keys[order]\ndel keys, kept\nstarts = np.flatnonzero(np.concatenate(([True], sorted_keys[1:] != sorted_keys[:-1])))\nunique_keys = sorted_keys[starts]\ndel sorted_keys\npmid_total = np.add.reduceat(pmid_counts[order].astype(np.int64), starts)\nsid_total = np.add.reduceat(sid_counts[order].astype(np.int64), starts)\nrepresentatives = order[starts]\ndel order, starts, pmid_counts, sid_counts\nlog(f\"{unique_keys.size:,} distinct structures\")\n\npositions, found = locate(unique_keys, pool_keys)\nin_pool = np.zeros(unique_keys.size, dtype=bool)\nin_pool[positions[found]] = True\nalways = in_pool | (pmid_total > 0)\nothers = np.minimum(sid_total[~always], 10_000)\nat_least = np.cumsum(np.bincount(others)[::-1])[::-1]\nfits = np.flatnonzero(at_least <= MAX_STRUCTURES - always.sum())\ncutoff = int(fits[0]) if fits.size else 10_001\nchosen = np.flatnonzero(always | (sid_total >= cutoff))\nlog(\n    f\"keeping {chosen.size:,}: {in_pool.sum():,} in the pool, {(pmid_total > 0).sum():,} with PubMed links, \"\n    f\"others with at least {cutoff} PubChem records\"\n)\n\ntexts = read_smiles(representatives[chosen], size)\npresent = np.flatnonzero(pd.notna(texts))\nchosen = chosen[present]\ntexts = texts[present]\nfinal_mass = masses[representatives[chosen]]\nby_mass = np.argsort(final_mass)\ntable = pa.table(\n    {\n        \"key\": pa.array(unique_keys[chosen][by_mass].astype(str).tolist(), type=pa.string()),\n        \"smiles\": pa.array(texts[by_mass].tolist(), type=pa.string()),\n        \"mass\": pa.array(final_mass[by_mass], type=pa.float64()),\n        \"pmid\": pa.array(pmid_total[chosen][by_mass], type=pa.int64()),\n        \"sid\": pa.array(sid_total[chosen][by_mass], type=pa.int64()),\n    }\n)\npq.write_table(table, OUTPUT, compression=\"zstd\", row_group_size=1_000_000)\nlog(f\"wrote {OUTPUT}: {table.num_rows:,} structures, {os.path.getsize(OUTPUT) / 1e9:.2f} GB\")\n\npopularity = np.log10(1.0 + pmid_total + sid_total)\nprint(\"\\nHow much of each group is in PubChem, and how well known it is (log10 of PubMed links + records):\")\nfor label, group in ((\"library\", library_keys), (\"COCONUT\", coconut_keys), (\"panel\", panel_keys)):\n    positions, found = locate(unique_keys, group)\n    print(f\"  {label:8s} {found.mean():6.1%} found, median popularity {np.median(popularity[positions[found]]):.2f}\")\nprint(f\"  {'kept':8s} {'':13s} median popularity {np.median(popularity[chosen]):.2f}\")\n\nsorted_mass = final_mass[by_mass]\nprint(\"\\nStructures kept within 5 ppm of some example masses:\")\nfor value in (250.12, 348.15, 500.25, 800.40):\n    low, high = np.searchsorted(sorted_mass, [value * (1 - 5e-6), value * (1 + 5e-6)])\n    print(f\"  {value:7.2f} Da: {high - low:,}\")\n\nprint(\"\\nMost linked structures, as a sanity check:\")\nfor row in np.argsort(-pmid_total[chosen])[:5]:\n    print(f\"  {pmid_total[chosen][row]:>9,} PubMed links, {sid_total[chosen][row]:>7,} records  {texts[row]}\")\nlog(\"DONE. Next: add this notebook as an input to Notebook 4.\")\n","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-11-04T05:59:43.332952Z","iopub.execute_input":"2026-11-04T05:59:43.333729Z","iopub.status.idle":"2026-11-04T06:19:16.907048Z","shell.execute_reply.started":"2026-11-04T05:59:43.333701Z","shell.execute_reply":"2026-11-04T06:19:16.906344Z"}},"outputs":[{"name":"stdout","text":"[   0.0 mi